@using GruenesBrett.Interfaces
@using GruenesBrett.Properties
@using GruenesBrett.ViewModels.Account

@inject ITextService TextService

@model RegistrationViewModel

@{
  var displayNameExplanation = TextService.GetText(Constants.Text.Account.DisplayNameExplanation);
  var displayNamePlaceholder = TextService.GetText(Constants.Text.Account.DisplayNamePlaceholder);
  var emailExplanation = TextService.GetText(Constants.Text.Account.EmailExplanation);
  var emailPlaceholder = TextService.GetText(Constants.Text.Account.EmailPlaceholder);

  var tooShortOrTooLong = SystemTexts.PasswordTooShortOrTooLong;
  var password = SystemTexts.Password;
  var minimumPasswordLength = Constants.Account.MinimumPasswordLength;
  var maximumPasswordLength = Constants.Account.MaximumPasswordLength;
  var passwordExplanation = string.Format(tooShortOrTooLong, password, maximumPasswordLength, minimumPasswordLength);
  var passwordPlaceholder = TextService.GetText(Constants.Text.Account.PasswortPlaceholder);

  var registrationBenefitsHeading = TextService.GetText(Constants.Text.Account.RegistrationBenefitsHeading);
  var registrationBenefitsText = TextService.GetText(Constants.Text.Account.RegistrationBenefitsText);

  var title = TextService.GetText(Constants.Text.Account.Registration);
  ViewData[Constants.ViewData.Title] = title;
}

<aside>
  <h2>@registrationBenefitsHeading</h2>
  @Html.Raw(registrationBenefitsText)

  <partial name="_SidebarLinks" />
</aside>
<section>
  <form method="post">
    <h1>@title</h1>
    <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>

    <div class="row">
      <fieldset>
        <label asp-for="Name">@Html.DisplayNameFor(m => m.Name)</label>
        <input asp-for="Name" autocomplete="name" aria-required="true" placeholder="@displayNamePlaceholder" required />
        <span asp-validation-for="Name" class="warning"></span>
      </fieldset>
      <p>@displayNameExplanation</p>
    </div>

    <div class="row">
      <fieldset>
        <label asp-for="Email">@Html.DisplayNameFor(m => m.Email)</label>
        <input asp-for="Email" autocomplete="email" aria-required="true" placeholder="@emailPlaceholder" required />
        <span asp-validation-for="Email" class="warning"></span>
      </fieldset>
      <p>@emailExplanation</p>
    </div>

    <div class="row">
      <fieldset>
        <label asp-for="Password">@Html.DisplayNameFor(m => m.Password)</label>
        <input asp-for="Password" autocomplete="new-password" aria-required="true" placeholder="@passwordPlaceholder" required />
        <span asp-validation-for="Password" class="warning"></span>
      </fieldset>
      <p>@passwordExplanation</p>
    </div>

    <fieldset>
      <label asp-for="ConfirmPassword">@Html.DisplayNameFor(m => m.ConfirmPassword)</label>
      <input asp-for="ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="@passwordPlaceholder" required />
      <span asp-validation-for="ConfirmPassword" class="warning"></span>
    </fieldset>

    <button type="submit">@title</button>
  </form>
</section>
