@using GruenesBrett.Interfaces

@inject ITextService TextService

@{
  var text = TextService.GetText(Constants.Text.Account.ResetPasswordConfirmationText);

  var title = TextService.GetText(Constants.Text.Account.ResetPasswordConfirmation);
  ViewData[Constants.ViewData.Title] = title;
}

<aside>
  <partial name="_SidebarLinks" />
</aside>
<section>
  <h1>@title</h1>
  @Html.Raw(text)
</section>
