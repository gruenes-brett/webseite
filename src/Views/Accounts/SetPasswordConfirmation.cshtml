@using GruenesBrett.Controllers
@using GruenesBrett.Interfaces
@using GruenesBrett.Properties
@using GruenesBrett.ViewModels.Accounts

@inject ITextService TextService

@{
  var text = TextService.GetText(Constants.Text.Accounts.SetPasswordConfirmationText);

  var title = TextService.GetText(Constants.Text.Accounts.SetPassword);
  ViewData[Constants.ViewData.Title] = title;
}

<aside>
  <partial name="_SidebarLinks" />
</aside>
<section>
  <h1>@title</h1>

  @Html.Raw(text)
</section>
