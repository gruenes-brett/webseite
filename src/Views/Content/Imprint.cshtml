@using GruenesBrett.Interfaces

@inject ITextService TextService

@{
  var licenses = TextService.GetText(Constants.Text.Content.Licenses);
  var licensesText = TextService.GetText(Constants.Text.Content.LicensesText);
  var termsOfService = TextService.GetText(Constants.Text.Content.TermsOfService);
  var termsOfServiceText = TextService.GetText(Constants.Text.Content.TermsOfServiceText);
  var imprintText = TextService.GetText(Constants.Text.Content.ImprintText);

  var title = TextService.GetText(Constants.Text.Content.Imprint);
  ViewData[Constants.ViewData.Title] = title;
}

<aside>
  <h2>@title</h2>
  @Html.Raw(imprintText)

  <partial name="_SidebarLinks" />
</aside>
<section>
  <h1>@termsOfService</h1>
  @Html.Raw(termsOfServiceText)

  <h1>@licenses</h1>
  @Html.Raw(licensesText)

