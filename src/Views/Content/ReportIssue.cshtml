@using GruenesBrett.Interfaces

@inject ITextService TextService

@{
  var text = TextService.GetText(Constants.Text.Content.ReportIssueText);

  var title = TextService.GetText(Constants.Text.Content.ReportIssue);
  ViewData[Constants.ViewData.Title] = title;
}

<aside>
  <partial name="_SidebarLinks" />
</aside>
<section>
  <h1>@title</h1>

  @Html.Raw(text)
</section>
