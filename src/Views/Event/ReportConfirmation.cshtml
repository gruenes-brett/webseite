@using GruenesBrett.Controllers
@using GruenesBrett.Interfaces
@using GruenesBrett.ViewModels.Event

@inject ITextService TextService

@model ReportViewModel

@{
  var text = TextService.GetText(Constants.Text.Event.ReportConfirmationText);

  var title = TextService.GetText(Constants.Text.Event.ReportConfirmation);
  ViewData[Constants.ViewData.Title] = title;
}

<aside>
  <partial name="../Shared/_SidebarLinks" />
</aside>
<section>
  <h1>@title</h1>
  @Html.Raw(text)
</section>
