@using GruenesBrett.Controllers
@using GruenesBrett.Extensions
@using GruenesBrett.Interfaces
@using GruenesBrett.Properties
@using GruenesBrett.ViewModels.Events

@inject IEventService EventService
@inject ITextService TextService

@model ExploreViewModel

@{
  var noResults = TextService.GetText(Constants.Text.Events.NoResults);
  var adjustFilters = TextService.GetText(Constants.Text.Events.AdjustFilters);
  var moreInformation = TextService.GetText(Constants.Text.Events.MoreInformation);
  var edit = TextService.GetText(Constants.Text.Event.Edit);

  var title = SystemTexts.Explore;
  ViewData["Title"] = title;
}

<aside>
  <partial name="../Shared/_Filters" for="FilterViewModel" />
  <partial name="../Shared/_SidebarLinks" />
</aside>
<section>
  @if (Model.Events.Count == 0)
  {
    <h1>@noResults</h1>
    @Html.Raw(adjustFilters)
  }
  else
  {
    <div class="articles">
      @foreach (var singleEvent in Model.Events)
      {
        var formattedTimeSpan = TextService.GetFormattedDateTimeSpan(singleEvent);
        var canEditEvent = await EventService.CanEditEventAsync(singleEvent, User);

        <article>
          <div class="category" style="background-color: @singleEvent.PrimaryCategory.BackgroundColor;"></div>
          <a asp-controller="@nameof(Event)" asp-action="@nameof(Event.Index)" asp-route-eventid="@singleEvent.ExternalId" tabindex="-1">
            @if (singleEvent.EventImage?.FileName?.HasValue() ?? false)
            {
              <img src="/@singleEvent.EventImage?.FileName" alt="@singleEvent.EventName" asp-append-version="true" />
            }
            else
            {
              <img src="/img/placeholder.svg" alt="@singleEvent.EventName" asp-append-version="true" />
            }
          </a>
          <h2>
            <a asp-controller="@nameof(Event)" asp-action="@nameof(Event.Index)" asp-route-eventid="@singleEvent.ExternalId">@singleEvent.EventName</a>
          </h2>
          <p>
            @Html.Raw(formattedTimeSpan)<br />
            @singleEvent.OrganizerName
            @if (canEditEvent)
            {
              <br />
              <a asp-controller="@nameof(Event)" asp-action="@nameof(Event.Edit)" asp-route-eventid="@singleEvent.InternalId">@edit</a>
            }
          </p>
          <p>@singleEvent.EventDescription.Truncate(350)</p>
          <p>&#x2B62; <a asp-controller="@nameof(Event)" asp-action="@nameof(Event.Index)" asp-route-eventid="@singleEvent.ExternalId">@moreInformation</a></p>
        </article>
      }
    </div>
  }
</section>
