@using GruenesBrett.Controllers
@using GruenesBrett.Interfaces
@using GruenesBrett.Properties

@inject ITextService TextService

@{
  var links = TextService.GetText(Constants.Text.Events.Links);
  var createEvent = SystemTexts.CreateEvent;
  var isAdministrator = User.IsInRole(Constants.Roles.Administrator);
  var showLog = TextService.GetText(Constants.Text.Events.ShowAuditLog);
  var reportIssue = TextService.GetText(Constants.Text.Content.ReportIssue);
}

<h2>@links</h2>

<ul>
  <li><a asp-controller="@nameof(Event)" asp-action="@nameof(Event.Create)">@createEvent</a></li>
  @if (isAdministrator)
  {
    <li><a asp-controller="@nameof(Events)" asp-action="@nameof(Events.ShowAuditLog)">@showLog</a></li>
  }
  <li><a asp-controller="@nameof(Content)" asp-action="@nameof(Content.ReportIssue)">@reportIssue</a></li>
</ul>
