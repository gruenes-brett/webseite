@using GruenesBrett.Controllers
@using GruenesBrett.Extensions
@using GruenesBrett.Interfaces
@using GruenesBrett.ViewModels.Settings

@inject ITextService TextService

@model EditTextsViewModel

@{
  var key = TextService.GetText(Constants.Text.Settings.Key);
  var value = TextService.GetText(Constants.Text.Settings.Value);
  var action = TextService.GetText(Constants.Text.Settings.Action);
  var edit = TextService.GetText(Constants.Text.Settings.Edit);

  var title = TextService.GetText(Constants.Text.Settings.EditTexts);
  ViewData[Constants.ViewData.Title] = title;
}

<aside>
  <partial name="_SidebarLinks" />
</aside>
<section>
  <h1>@title</h1>
  <table>
    <thead>
      <tr>
        <th>@key</th>
        <th>@value</th>
        <th>@action</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var text in Model.Texts)
      {
        <tr>
          <th>@text.Key</th>
          <td>@text.Value.Truncate(50)</td>
          <td><a asp-controller="@nameof(Settings)" asp-action="@nameof(Settings.EditText)" asp-route-key="@text.Key" >@edit</a></td>
        </tr>
      }
    </tbody>
  </table>
</section>
