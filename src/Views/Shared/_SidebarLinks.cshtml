@using GruenesBrett.Controllers
@using GruenesBrett.Interfaces

@inject ITextService TextService
@inject IUrlService UrlService

@{
  var links = TextService.GetText(Constants.Text.Content.Links);

  var imprint = TextService.GetText(Constants.Text.Content.Imprint);
  var termsOfService = TextService.GetText(Constants.Text.Content.TermsOfService);
  var dataPrivacyPolicy = TextService.GetText(Constants.Text.Content.DataPrivacyPolicy);
  var reportIssue = TextService.GetText(Constants.Text.Content.ReportIssue);
  var changelog = TextService.GetText(Constants.Text.Content.Changelog);
}

<h2>@links</h2>

<ul>
  <li><a asp-controller="@nameof(Content)" asp-action="@nameof(Content.Imprint)">@imprint / @termsOfService</a></li>
  <li><a asp-controller="@nameof(Content)" asp-action="@nameof(Content.DataPrivacyPolicy)">@dataPrivacyPolicy</a></li>
  <li><a asp-controller="@nameof(Content)" asp-action="@nameof(Content.ReportIssue)">@reportIssue</a></li>
  <li><a asp-controller="@nameof(Content)" asp-action="@nameof(Content.Changelog)">@changelog</a></li>
</ul>
